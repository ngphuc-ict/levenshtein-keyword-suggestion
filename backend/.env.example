# Đường dẫn tới dictionary.txt. Mặc định là ../dictionary.txt so với thư mục backend.
DICTIONARY_PATH=../dictionary.txt

# Số mục tối đa trong bộ đệm LRU. Đặt 0 để tắt.
SUGGEST_CACHE_SIZE=1024

# Các origin được phép gọi API, phân tách bằng dấu phẩy. "*" nghĩa là tất cả.
CORS_ORIGINS=*

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
